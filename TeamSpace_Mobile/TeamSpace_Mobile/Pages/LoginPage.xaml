<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TeamSpace_Mobile.Pages.LoginPage"
             Title="">
    <ContentView>
        <ContentView.Content>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto" />
                    <RowDefinition />
                    <RowDefinition Height="auto" />
                </Grid.RowDefinitions>

                <Path Grid.Row="0"
                Data="M91.9756 118.946C54.6807 117.406 45.3404 74.8318 8.04627 73.2746C4.51657 73.1272 -1 73.2746 -1 73.2746V0H390C390 0 364.049 43.327 337.733 59.7238C289.777 89.6039 247.09 43.3626 192.992 59.7238C149.211 72.9649 137.682 120.832 91.9756 118.946Z">
                    <Path.Fill>
                        <LinearGradientBrush StartPoint="-0.001,-0.001" EndPoint="0.18,1.8">
                            <GradientStop Color="#EECE13" Offset="0" />
                            <GradientStop Color="#B210FF" Offset="1" />
                        </LinearGradientBrush>
                    </Path.Fill>
                </Path>

                <Grid Grid.Row="1" x:Name="ContentGrid">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="80" />
                        <RowDefinition Height="80" />
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="120" />
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="75" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="75" />
                    </Grid.ColumnDefinitions>

                    <Label 
                        Grid.Row="0" Grid.Column="1" 
                        FontFamily="TiltNeon" FontSize="64" 
                        TextColor="#262626" 
                        HorizontalTextAlignment="Center" 
                        Text="Hello" 
                    />
                    <Label Grid.Row="1" Grid.Column="1" 
                        FontFamily="TiltNeon" FontSize="18" 
                        TextColor="#262626" 
                        HorizontalTextAlignment="Center" 
                        Text="Sign in to your account" 
                        Margin="0,5,0,40" 
                    />

                    <StackLayout 
                        Grid.Row="4" Grid.Column="1" 
                        Orientation="Horizontal" HorizontalOptions="End" 
                        Margin="0,0,-35,0">
                        <Button
                            FontFamily="TiltNeon" FontSize="14" 
                            TextColor="#BEBEBE" 
                            Text="Forgot your password?"  
                            BackgroundColor="Transparent"
                            Clicked="BtnClicked_ResetPassword" 
                        />
                    </StackLayout>

                    <StackLayout 
                        Grid.Row="5" Grid.Column="1" 
                        Orientation="Horizontal" HorizontalOptions="End" 
                        Margin="0,30,-30,0">
                        <Label
                            FontFamily="TiltNeon" FontSize="20" 
                            TextColor="#262626" 
                            Text="LogIn  "
                        />
                        <AbsoluteLayout>
                            <Button
                                CornerRadius="17"
                                WidthRequest="55" HeightRequest="35"
                                Clicked="BtnClicked_LogIn">
                                <Button.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#F97794" Offset="0" />
                                        <GradientStop Color="#623AA2" Offset="1" />
                                    </LinearGradientBrush>
                                </Button.Background>
                            </Button>
                            <Image
                                Margin="18,7"
                                WidthRequest="20" HeightRequest="20"
                                VerticalOptions="Center"
                                HorizontalOptions="Center"
                                Source="right_arrow.png" 
                            />
                        </AbsoluteLayout>
                    </StackLayout>

                    <Label 
                        Grid.Row="6" Grid.Column="1" 
                        FontFamily="TiltNeon" FontSize="15" 
                        TextColor="#262626" 
                        HorizontalTextAlignment="Center"
                        Text="Or sign in using social media" 
                    />

                    <ImageButton
                        Grid.Row="7" Grid.Column="1"
                        Source="google_icon.png"
                        WidthRequest="35" HeightRequest="35"
                        Margin="0,15,0,25"
                        Clicked="BtnClicked_GoogleSignIn"
                    />

                    <Label 
                        Grid.Row="8" Grid.Column="1" 
                        FontFamily="TiltNeon" FontSize="15" 
                        TextColor="#262626" 
                        HorizontalTextAlignment="Center" 
                        Text="Don’t have an account?" 
                        Margin="0,0,48,0" 
                    />
                    <Frame 
                        Grid.Row="8" Grid.Column="1" 
                        BackgroundColor="Transparent"
                        BorderColor="Transparent"
                        Padding="0"
                        Margin="162,-1,0,0">
                        <Label 
                            FontFamily="TiltNeon" FontSize="15"
                            TextColor="#262626"
                            Text="Create" 
                            TextDecorations="Underline"
                            HorizontalOptions="Center" 
                            VerticalOptions="Center" 
                        />
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Tapped="BtnClicked_CreateAccount" />
                        </Frame.GestureRecognizers>
                    </Frame>
                </Grid>

                <Path Grid.Row="2" 
                      RotationX="180" RotationY="180" 
                      Margin="0,0,0,-35"
                Data="M91.9756 118.946C54.6807 117.406 45.3404 74.8318 8.04627 73.2746C4.51657 73.1272 -1 73.2746 -1 73.2746V0H390C390 0 364.049 43.327 337.733 59.7238C289.777 89.6039 247.09 43.3626 192.992 59.7238C149.211 72.9649 137.682 120.832 91.9756 118.946Z">
                    <Path.Fill>
                        <LinearGradientBrush StartPoint="-0.001,-0.001" EndPoint="0.18,1.9">
                            <GradientStop Color="#EECE13" Offset="0" />
                            <GradientStop Color="#B210FF" Offset="1" />
                        </LinearGradientBrush>
                    </Path.Fill>
                </Path>
            </Grid>
        </ContentView.Content>
    </ContentView>
</ContentPage>