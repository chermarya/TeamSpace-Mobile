<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TeamSpace_Mobile.Pages.ContainerStartPage"
             Title="ContainerStartPage">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="80" />
        </Grid.RowDefinitions>

        <ContentView Grid.Row="0" Grid.RowSpan="2" x:Name="MainContentView"/>

        <Frame
            Grid.Row="1"
            HasShadow="True"
            CornerRadius="25"
            BackgroundColor="White" 
            HeightRequest="120" 
            Margin="0,0,0,-40"
            Padding="0, 10, 0, 60">
            <StackLayout 
                Orientation="Horizontal"
                HorizontalOptions="Center"
                x:Name="NavigateStack" 
            />
        </Frame>
    </Grid>
</ContentPage>