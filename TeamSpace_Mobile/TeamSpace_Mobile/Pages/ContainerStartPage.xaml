<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TeamSpace_Mobile.Pages.ContainerStartPage"
             Title="ContainerStartPage">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="80" />
        </Grid.RowDefinitions>

        <ContentView Grid.Row="0" Grid.RowSpan="2" x:Name="MainContentView"/>

        <Frame
            Grid.Row="1"
            BackgroundColor="Transparent"
            BorderColor="Transparent"
            Padding="0"
            HeightRequest="150">
            <AbsoluteLayout Padding="0, 30, 0, 0">
                <BoxView
                    x:Name="BoxViewBorder"
                    CornerRadius="25"
                    BackgroundColor="White" 
                    HeightRequest="120"
                    WidthRequest="480"
                    Margin="0,0,0,-40"
                />

                <StackLayout 
                    BackgroundColor="Transparent" 
                    x:Name="BgNavStack"
                    Orientation="Horizontal"
                    HorizontalOptions="Center"
                    Padding="10, 0"
                    ZIndex="10"
                />
            </AbsoluteLayout>
        </Frame>
    </Grid>
</ContentPage>